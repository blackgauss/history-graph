# Nothing reads dotenv files today: `uv run` and the MCP server take these from
# the real environment (opencode mcp config sets HG_* absolutes). Copy values
# into your shell/export as needed. All have sane defaults except where noted.

# OpenAlex politeness pool (any address; real one gets steadier limits)
OPENALEX_MAILTO=you@example.com
# OpenAlex API key (credit budget / raised limits; sent as api_key= parameter)
OPENALEX_API_KEY=

# Sci-Hub stage (scripts/record_cassettes.py, download.py)
# SCIHUB_MIRROR=https://sci-hub.ru/
# SCIHUB_MIN_INTERVAL=5

# Determinism / test knobs
# HG_CASSETTES=1                 # replay tests/cassettes instead of live HTTP
# HG_CASSETTE_MODE=record        # record live traffic into cassettes
# HG_UPDATE_GOLDENS=1            # bless goldens from current observed output
# HG_GRAPH_CACHE=data/cache      # citation_path/dossier probe cache dir
# HG_THREAD_DIR / HG_THREAD_YAML / HG_SEED_TXT / HG_PDFS_DIR /
# HG_PROPOSED_DIR / HG_CANDIDATES_DIR   # data locations (defaults under data/)
# HG_ALLOW_CURATED_WRITES=1   # required for apply_proposals/promote_thread to
                             # actually write curated inputs (human gate for agents)
# PYTHONHASHSEED=0               # CI sets this for deterministic ordering
